{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dxm-auto-uikit.local/real_dxm_write_scope.schema.json",
  "title": "Real DXM Write Scope and Approval v1",
  "description": "Fail-closed Path B scope and ApprovalFile nonce envelope. Cross-field hash, ordering, expiry, and scope/approval equality checks are enforced by app/backend/src/real_dxm_write_scope.py; one-time nonce consumption is enforced by the persistence transaction.",
  "oneOf": [
    {
      "$ref": "#/$defs/writeScope"
    },
    {
      "$ref": "#/$defs/writeApproval"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "gitHead": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "boundedText": {
      "allOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?%\\s](?:[^*?%\\r\\n]*[^*?%\\s])?$"
        },
        {
          "not": {
            "pattern": "^(?:[Aa][Ll][Ll]|[Aa][Nn][Yy]|[Aa][Ll][Ll]_[Ff][Ii][Ee][Ll][Dd][Ss]|[Aa][Nn][Yy]_[Ff][Ii][Ee][Ll][Dd]|[Aa][Ll][Ll]_[Pp][Rr][Oo][Dd][Uu][Cc][Tt][Ss]|[Aa][Nn][Yy]_[Pp][Rr][Oo][Dd][Uu][Cc][Tt])$"
          }
        }
      ]
    },
    "canonicalUtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{6})?Z$"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._~:-]+$"
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountContextHash"
      ],
      "properties": {
        "accountContextHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shopId",
        "shopName"
      ],
      "properties": {
        "shopId": {
          "type": "integer",
          "minimum": 1
        },
        "shopName": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "snapshotSha256",
        "taskId"
      ],
      "properties": {
        "snapshotId": {
          "type": "integer",
          "minimum": 1
        },
        "snapshotSha256": {
          "$ref": "#/$defs/sha256"
        },
        "taskId": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head"
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/gitHead"
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "git_head",
        "git_dirty",
        "status_count",
        "status_sha256",
        "execution_file_count",
        "execution_tree_sha256"
      ],
      "properties": {
        "schema": {
          "const": "dxm.git-worktree.identity.v1"
        },
        "git_head": {
          "$ref": "#/$defs/gitHead"
        },
        "git_dirty": {
          "const": false
        },
        "status_count": {
          "const": 0
        },
        "status_sha256": {
          "const": "E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855"
        },
        "execution_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "execution_tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeInstanceId",
        "browserRuntimeId",
        "browserSessionId"
      ],
      "properties": {
        "runtimeInstanceId": {
          "$ref": "#/$defs/boundedText"
        },
        "browserRuntimeId": {
          "$ref": "#/$defs/boundedText"
        },
        "browserSessionId": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "l2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidenceFingerprint"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "evidenceFingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "allowedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "saveStage",
        "preimageSha256",
        "expectedSha256"
      ],
      "properties": {
        "field": {
          "allOf": [
            {
              "$ref": "#/$defs/boundedText"
            },
            {
              "not": {
                "pattern": "(?:[Pp][Uu][Bb][Ll][Ii][Ss][Hh]|发布)"
              }
            }
          ]
        },
        "saveStage": {
          "enum": [
            "SAVE1",
            "SAVE2"
          ]
        },
        "preimageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "expectedSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "save1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "maxPhysicalRequests"
      ],
      "properties": {
        "stage": {
          "const": "SAVE1"
        },
        "maxPhysicalRequests": {
          "const": 1
        }
      }
    },
    "save2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "maxPhysicalRequests"
      ],
      "properties": {
        "stage": {
          "const": "SAVE2"
        },
        "maxPhysicalRequests": {
          "const": 1
        }
      }
    },
    "orderedProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "productId",
        "allowedFields",
        "saves"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "productId": {
          "type": "integer",
          "minimum": 1
        },
        "allowedFields": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/allowedField"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": [
                  "saveStage"
                ],
                "properties": {
                  "saveStage": {
                    "const": "SAVE1"
                  }
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": [
                  "saveStage"
                ],
                "properties": {
                  "saveStage": {
                    "const": "SAVE2"
                  }
                }
              },
              "minContains": 1
            }
          ]
        },
        "saves": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/save1"
            },
            {
              "$ref": "#/$defs/save2"
            }
          ],
          "items": false
        }
      }
    },
    "writeScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stage",
        "path",
        "issuedAt",
        "expiresAt",
        "nonce",
        "account",
        "shop",
        "snapshot",
        "git",
        "worktree",
        "runtime",
        "l2",
        "orderedProducts",
        "publishAllowed",
        "maxPhysicalRequestsPerSave",
        "scopeSha256"
      ],
      "properties": {
        "schema": {
          "const": "real_dxm_write_scope.v1"
        },
        "stage": {
          "const": "execute"
        },
        "path": {
          "const": "B"
        },
        "issuedAt": {
          "$ref": "#/$defs/canonicalUtcTimestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/canonicalUtcTimestamp"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "account": {
          "$ref": "#/$defs/account"
        },
        "shop": {
          "$ref": "#/$defs/shop"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "git": {
          "$ref": "#/$defs/git"
        },
        "worktree": {
          "$ref": "#/$defs/worktree"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "l2": {
          "$ref": "#/$defs/l2"
        },
        "orderedProducts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/orderedProduct"
          }
        },
        "publishAllowed": {
          "const": false
        },
        "maxPhysicalRequestsPerSave": {
          "const": 1
        },
        "scopeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "writeApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "stage",
        "scopeSha256",
        "nonce",
        "approvedAt",
        "expiresAt",
        "approvedBy",
        "decision",
        "approvalSha256"
      ],
      "properties": {
        "schema": {
          "const": "real_dxm_write_approval.v1"
        },
        "stage": {
          "const": "execute"
        },
        "scopeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "approvedAt": {
          "$ref": "#/$defs/canonicalUtcTimestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/canonicalUtcTimestamp"
        },
        "approvedBy": {
          "$ref": "#/$defs/boundedText"
        },
        "decision": {
          "const": "APPROVE"
        },
        "approvalSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
